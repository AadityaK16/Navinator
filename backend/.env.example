ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
DEMO_MODE=cached
REPO_ROOT=../demo-repo/backend
ANTHROPIC_WORKSPACE_ID=

# Private mode: run the agent on a local model so code never leaves this machine.
# LLM_PROVIDER=ollama          # or openai_compat for LM Studio / llama.cpp server
# LOCAL_MODEL=llama3.1:8b      # any tool-calling model: qwen2.5:7b, llama3.1:8b
# LOCAL_LLM_URL=http://localhost:11434/v1

# Grok: writes richer tour narration, reads it aloud, and powers regrouping.
# XAI_API_KEY=
# XAI_MODEL=grok-4            # any current Grok chat model id
# XAI_VOICE=ara               # ara, eve, rex, sal, leo
